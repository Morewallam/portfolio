---
import { experience } from "../data/content";
---

<section id="experience" class="mx-auto max-w-2xl px-6 py-16">
  <div class="glass-box-light p-6 rounded-xl">
    <h2 class="mb-4 pl-3 text-3xl">Experience</h2>
    <div class="flex flex-col gap-6 justify-between items-center">
      {experience.map((item) => (
      <div class="flex-row items-center max-w-md sm:max-w-lg glass-box-light rounded-xl p-3">
        <div class="mb-2">
          {item.dates}
        </div>
        <div>
          <div><span class="text-xl">{item.header}</span></div>
          <div class="mb-3">
            <strong >{item.subheader}</strong>
          </div>
          <div class="mt-3">
            <span >{item.description}</span>
          </div>
          
        </div>
      </div>
      ))}

    </div>
    </div>
  
</section>

<style>
  h2 {
    font-family: var(--font-dela-gothic);
  }
</style>
