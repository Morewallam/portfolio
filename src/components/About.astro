---
import { about } from "../data/content";
---

<section id="about" class="mx-auto max-w-lg px-6 py-16">
  <div class="glass-box rounded-xl p-3">
    <h1 class="text-3xl font-bold mb-3">
      Hi, I'm <span class="text-nowrap">Sean Wallace</span>
    </h1>
    <span class="text-lg">
      {about.passage}
    </span>
  </div>
</section>

<style>
  h1 {
    font-family: var(--font-dela-gothic);
  }
</style>
