---


import { socials } from "../data/content";
import { Icon } from 'astro-icon/components'
---

<section id="contact" class="mx-auto w-fit px-6 py-16 h-[50vh]">
  <div class="glass-box rounded-xl p-3">

    <span class="text-xl ">Thank you for looking through my website. I hope you enjoyed it.</span>
    <h2 class="mb-2 mt-4 text-3xl font-medium">Get in touch</h2>
    
    {socials.map((info)=>(
    <div><Icon name={info.icon} class="text-2xl text-black inline mr-1"/><a
            href={info.url} target="_blank"
            rel="noopener noreferrer">{info.label}</a></div>
    ))}

  </div>
  
  
</section>