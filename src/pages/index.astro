---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Sean Wallace — Portfolio">
  <div id="background-render" class="fixed top-0 left-0 w-full h-lvh z-[-1]"></div>
  <div id="loading-page" class="fixed top-0 left-0 bg-blue-50 flex h-[100dvw] w-[100dvw] justify-center z-[5] opacity-100 transition-opacity delay-500 duration-300 ease-in-out">
    <div id="loading-bar-container" class="flex flex-col w-md h-md justify-center p-10">
      <span id="loading-message">loading</span>
      <div id="loading-bar-border" class="rounded-xl w-[100%] content-center border-3 bg-neutral-500">
        <div id="loading-bar-fill" class="rounded-lg h-6 w-[0%] content-center transition-[width] bg-blue-500 duration-500 ease-in ">
        </div>
      </div>
      
    </div>
  </div>
  <div id="page-content" class="invisible">
    <Hero />

    <div id="animation-wrapper-door" class="h-[20lvh]" >
    </div>
     
    
    <div id="animation-wrapper-door-to-water" class="h-[90lvh]">

    </div>
    <div id="animation-wrapper-water">
      <About />
      <Experience />
    </div>
    
    <div id="animation-wrapper-water-to-tokonoma" class="h-[120lvh]"></div>

    <div id="animation-wrapper-tokonoma">
      <Projects />
      <Skills />
    </div>
    
    <div id="animation-wrapper-tokonoma-to-table" class="h-[90lvh]">
    </div>

    <div id="animation-wrapper-table">
    <Contact />
     </div>
  
  </div>

</Layout>

<style>
  #loading-message {
    font-family: var(--font-dela-gothic);
  }
</style>

<script>
  import { LinearInterpolant } from "three";
import { HeroScene } from "../scripts/heroScene";

  const container = document.getElementById("background-render");

  const totalAnimationFrames = 320

  const panInStartFrame = 48
  const outsideDoorOpenStartFrame = 96
  const panToTokomaStartFrame = 144
  const outsideDoorCloseStartFrame = 192
  const panToTableStartFrame = 240 
  const panToTableEndFrame = 288

  const aniWrapperDoor = document.getElementById('animation-wrapper-door')as HTMLElement;
  const aniWrapperDoorToWater = document.getElementById('animation-wrapper-door-to-water')as HTMLElement;
  const aniWrapperWater = document.getElementById('animation-wrapper-water')as HTMLElement;
  const aniWrapperWaterToTokonoma = document.getElementById('animation-wrapper-water-to-tokonoma')as HTMLElement;
  const aniWrapperTokonoma = document.getElementById('animation-wrapper-tokonoma')as HTMLElement;
  const aniWrapperTokonomaToTable = document.getElementById('animation-wrapper-tokonoma-to-table')as HTMLElement;
  const aniWrapperTable = document.getElementById('animation-wrapper-table')as HTMLElement;

  const loadingPage = document.getElementById('loading-page') as HTMLElement;
  const loadingBar = document.getElementById('loading-bar-fill') as HTMLElement;
  const pageContent = document.getElementById('page-content') as HTMLElement;

  function setPercent(percent: number|null){
    if(percent !== null){
      loadingBar.style.width = `${percent}%`
    }
  }

  type AnimationSegment = {
    wrapper: HTMLElement;
    startFrame: number;
    endFrame: number;
  };

  
  function getWrapperProgress(wrapper: HTMLElement): number {
    const rect = wrapper.getBoundingClientRect();
    const viewportHeight = window.innerHeight/2;

    const amountmoved = viewportHeight - rect.top 
    const percent = Math.min(amountmoved/rect.height,1)
    return percent;
  }

 
  const segments: AnimationSegment[] = [
    { wrapper: aniWrapperDoor,      startFrame: 0,   endFrame: panInStartFrame },
    { wrapper: aniWrapperDoorToWater,      startFrame: panInStartFrame,   endFrame: panToTokomaStartFrame },
    { wrapper: aniWrapperWater,      startFrame: panToTokomaStartFrame,   endFrame: panToTokomaStartFrame },
    { wrapper: aniWrapperWaterToTokonoma,  startFrame: panToTokomaStartFrame,  endFrame: outsideDoorCloseStartFrame },
    { wrapper: aniWrapperTokonoma,  startFrame: outsideDoorCloseStartFrame,  endFrame: panToTableStartFrame },
    { wrapper: aniWrapperTokonomaToTable,  startFrame: panToTableStartFrame, endFrame: panToTableEndFrame },
    { wrapper: aniWrapperTable,  startFrame: panToTableEndFrame, endFrame: totalAnimationFrames },
  ];
  
  function computeFrame(): number {
    for (let i = 0 ; i<segments.length; i++) {
      const rect = segments[i].wrapper.getBoundingClientRect();
      if (rect.top <= window.innerHeight/2 && rect.bottom > window.innerHeight/2) {
        const progress = getWrapperProgress(segments[i].wrapper);
        const { startFrame, endFrame } = segments[i];
        return startFrame + progress * (endFrame - startFrame);
      }
    }
    return segments[0].startFrame;
  }

  let framePending = false;
  function onScroll(scene:HeroScene) {
    if (framePending) return;
    framePending = true;
    requestAnimationFrame(() => {
      framePending = false;
      scene.setanimateframe(computeFrame());
    });
  }

  if (container) {
    const scene = new HeroScene(container, setPercent, () => {
      scene.startrender();
      scene.setanimateframe(computeFrame());
      requestAnimationFrame(() => {
          setPercent(100)
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              //Set the progress to 100% and let the animation get there
              loadingPage.style.opacity = "0";
              //Fade out the loadingPage
              pageContent.classList.remove("invisible");
              });
          });     
      })

      setTimeout(()=>{
        loadingPage.classList.add('hidden')
      },800)
      
       
      
    });

    window.addEventListener("scroll", () => onScroll(scene), { passive: true });
    window.addEventListener("beforeunload", () => scene.dispose());
  }

  

</script>