---
import { experience } from "../data/content";
---

<section id="experience" class="mx-auto max-w-[1100px] px-6 py-16">
  <h2 class="mb-4 text-xl font-medium">Experience</h2>
  <ol class="flex flex-col gap-6">
    {experience.map((item) => (
      <li class="flex-row items-center w-md sm:w-lg glass-box">
      <div>
        {item.dates}
      </div>
      <div>
        <strong>{item.header}</strong>
        <br/>
        <strong>{item.subheader}</strong>
        <br/>
        <span>{item.description}</span>
      </div>
    </li>
    ))}

  </ol>
</section>
