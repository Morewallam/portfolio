---
import type { Project } from "../data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class:list={["overflow-hidden rounded-xl border border-neutral-200 glass-box-light max-w-md lg:max-w-xl mt-3"]}>
  <img
    src={project.image}
    alt={`Screenshot of ${project.title}`}
    loading="lazy"
    class="w-full bg-neutral-100 object-contain"
  />
  <div class="p-4">
    <h3 class="mb-1 font-medium">{project.title}</h3>
    <p class="mb-3 text-sm text-neutral-500">{project.description}</p>
    <ul class="mb-3 flex flex-wrap gap-2 text-xs text-neutral-400">
      {project.tech.map((t) => <li>{t}</li>)}
    </ul>
    <div class="flex gap-4 text-sm">
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noopener" class="underline">Live</a>
      )}
      {project.codeUrl && (
        <a href={project.codeUrl} target="_blank" rel="noopener" class="underline">Code</a>
      )}
    </div>
  </div>
</article>
