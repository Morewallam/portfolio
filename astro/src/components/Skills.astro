---
import { skills } from "../data/content";
---

<section id="skills" class="mx-auto max-w-[1100px] px-6 py-16 glass-box">
  <h2 class="mb-4 text-xl font-medium">Skills</h2>
  <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
    {skills.map((group) => (
      <div class="glass-box">
        <h3 class="mb-2 text-xs font-medium uppercase tracking-wide text-neutral-400">
          {group.category}
        </h3>
        <ul class="flex flex-col gap-1 text-sm">
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
